#!/bin/sh
# VANTOR Installer — Minimal edition, TUI front end.
set -eu

VERSION="0.2.2"
TARGET=""
HOSTNAME="vantor"
USERNAME="live"
NYAN_BIN="/usr/bin/nyan"
[ ! -r /etc/nyan.conf ] || . /etc/nyan.conf
NYAN_ARCH=${NYAN_ARCH:-x86_64}

die() { printf '[VANTOR Installer] ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '[VANTOR Installer] %s\n' "$*"; }
valid_name() { case "$1" in ''|[!a-z]*|*[!a-z0-9-]*) return 1;; esac; [ "${#1}" -le 32 ]; }

ask() {
    title=$1 prompt=$2 default=$3
    if command -v dialog >/dev/null 2>&1; then
        answer=$(dialog --stdout --title "$title" --inputbox "$prompt" 9 64 "$default") || return 1
    else
        printf '%s [%s]: ' "$prompt" "$default" >/dev/tty
        IFS= read -r answer </dev/tty || return 1
        answer=${answer:-$default}
    fi
    printf '%s' "$answer"
}

message() {
    if command -v dialog >/dev/null 2>&1; then
        dialog --title "VANTOR Installer" --msgbox "$1" 10 68
    else
        printf '\n%s\n\nPress Enter to continue...' "$1" >/dev/tty
        IFS= read -r _ </dev/tty || true
    fi
}

menu() {
    if command -v dialog >/dev/null 2>&1; then
        dialog --clear --title "VANTOR Linux — Minimal" --menu "ONE SYSTEM. EVERY GENERATION.\n\nChoose an action:" 18 72 6 \
            install "Install VANTOR Minimal" \
            configure "Configure installed system" \
            boot "Prepare installed boot files" \
            about "About this installer" \
            network "Configure network" \
            mirror "Configure Nyan mirror" \
            packages "Install additional packages" \
            prefs "Language, timezone and hostname" \
            storage "Inspect disks and partitions" \
            mountroot "Mount existing Linux partition" \
            bootloader "Install GRUB bootloader" \
            exit "Exit" 3>&1 1>&2 2>&3
    else
        printf '\n==============================================\n' >/dev/tty
        printf ' VANTOR LINUX — MINIMAL INSTALLER %s\n' "$VERSION" >/dev/tty
        printf ' ONE SYSTEM. EVERY GENERATION.\n' >/dev/tty
        printf '==============================================\n' >/dev/tty
        printf '1) Install VANTOR Minimal\n2) Configure installed system\n3) Prepare installed boot files\n4) Configure network\n5) Nyan mirror\n6) Additional packages\n7) System preferences\n8) About\n9) Inspect disks\n10) Mount existing Linux partition\n11) Install GRUB bootloader\n12) Exit\nSelect: ' >/dev/tty
        IFS= read -r choice </dev/tty || return 1
        case "$choice" in 1) printf install;; 2) printf configure;; 3) printf boot;; 4) printf network;; 5) printf mirror;; 6) printf packages;; 7) printf prefs;; 8) printf about;; 9) printf storage;; 10) printf mountroot;; 11) printf bootloader;; *) printf exit;; esac
    fi
}

network_setup() {
 if [ "$#" -gt 0 ]; then target=$1; else target=$(ask "Network" "Installed system root:" "/mnt") || return 0; fi
 iface=$(ask "Network" "Interface (e.g. eth0):" "eth0") || return 0
 mode=$(ask "Network" "Mode: dhcp or static:" "dhcp") || return 0
 case "$iface" in ''|*[!A-Za-z0-9_.:-]*) die "invalid interface";; esac
 mkdir -p "$target/etc/vantor"
 if [ "$mode" = dhcp ]; then
   printf 'MODE=dhcp\nINTERFACE=%s\n' "$iface" > "$target/etc/vantor/network.conf"
   if command -v udhcpc >/dev/null 2>&1; then /bin/busybox udhcpc -s /usr/share/udhcpc/default.script -i "$iface" -b -q -t 5 -T 2 || message "DHCP did not receive a lease."; fi
 else
   [ "$mode" = static ] || die "mode must be dhcp or static"
   address=$(ask "Static IPv4" "Address/prefix:" "192.168.1.50/24") || return 0
   gateway=$(ask "Static IPv4" "Gateway:" "192.168.1.1") || return 0
   dns=$(ask "Static IPv4" "DNS:" "1.1.1.1") || return 0
   valid_ipv4_cidr "$address" && valid_ipv4 "$gateway" && valid_ipv4 "$dns" || die "invalid IPv4 settings"
   printf 'MODE=static\nINTERFACE=%s\nADDRESS=%s\nGATEWAY=%s\nDNS=%s\n' "$iface" "$address" "$gateway" "$dns" > "$target/etc/vantor/network.conf"
   command -v ip >/dev/null 2>&1 || die "BusyBox ip applet is required for static IPv4"
   ip link set "$iface" up || true
   ip addr replace "$address" dev "$iface" || die "could not apply address"
   ip route replace default via "$gateway" dev "$iface" || true
   printf 'nameserver %s\n' "$dns" > /etc/resolv.conf
 fi
 message "Network configured for the Live session and saved to the installed system."
}

valid_ipv4() {
 printf '%s\n' "$1" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/ || $i>255) exit 1; exit 0} {exit 1}'
}
valid_ipv4_cidr() {
 addr=${1%/*}; prefix=${1#*/}
 case "$prefix" in ''|*[!0-9]*) return 1;; esac
 [ "$addr" != "$1" ] && [ "$prefix" -ge 1 ] && [ "$prefix" -le 32 ] && valid_ipv4 "$addr"
}
mirror_setup() {
 target=$(ask "Nyan mirror" "Installed system root:" "/mnt") || return 0
 repo=$(ask "Nyan mirror" "HTTPS repository base URL:" "https://vantor-linux.cristopheriguaran-7.workers.dev") || return 0
 case "$repo" in https://*) ;; *) die "mirror must use HTTPS";; esac
 case "$repo" in *[!A-Za-z0-9:/._+-]*) die "invalid URL";; esac
 mkdir -p "$target/etc"
 arch=$(awk -F= '$1=="NYAN_ARCH"{print $2}' "$target/etc/nyan.conf" 2>/dev/null || true)
 [ -n "$arch" ] || arch=${NYAN_ARCH:-x86_64}
 printf '# Nyan repository\nNYAN_REPO=%s\nNYAN_ARCH=%s\n' "$repo" "$arch" > "$target/etc/nyan.conf"
 message "Nyan mirror saved."
}
packages_setup() {
 if [ "$#" -gt 0 ]; then target=$1; else target=$(ask "Nyan packages" "Installed system root:" "/mnt") || return 0; fi
 [ -x "$NYAN_BIN" ] || die "Nyan not found"
 repo=$(awk -F= '$1=="NYAN_REPO"{print $2}' "$target/etc/nyan.conf" 2>/dev/null || true)
 arch=$(awk -F= '$1=="NYAN_ARCH"{print $2}' "$target/etc/nyan.conf" 2>/dev/null || true)
 [ -n "$repo" ] || repo="https://vantor-linux.cristopheriguaran-7.workers.dev"
 [ -n "$arch" ] || arch=${NYAN_ARCH:-x86_64}
 NYAN_ROOT="$target" NYAN_REPO="$repo" NYAN_ARCH="$arch" "$NYAN_BIN" update
 packages=$(ask "Additional packages" "Package names separated by spaces (blank skips):" "") || return 0
 for pkg in $packages; do NYAN_ROOT="$target" NYAN_REPO="$repo" NYAN_ARCH="$arch" "$NYAN_BIN" install "$pkg"; done
 message "Package selection complete."
}
preferences_setup() {
 if [ "$#" -gt 0 ]; then target=$1; else target=$(ask "System preferences" "Installed system root:" "/mnt") || return 0; fi
 current_hostname=$(cat "$target/etc/hostname" 2>/dev/null || echo vantor)
 hostname=$(ask "Hostname" "Computer name:" "$current_hostname") || return 0
 timezone=$(ask "Timezone" "Timezone (e.g. America/Santiago):" "America/Santiago") || return 0
 locale=$(ask "Locale" "Locale (e.g. es_CL.UTF-8):" "es_CL.UTF-8") || return 0
 valid_name "$hostname" || die "invalid hostname"
 case "$timezone" in ''|*[!A-Za-z0-9_+/-]*) die "invalid timezone";; esac
 case "$locale" in ''|*[!A-Za-z0-9_.@-]*) die "invalid locale";; esac
 mkdir -p "$target/etc"
 printf '%s\n' "$hostname" > "$target/etc/hostname"
 printf 'LANG=%s\n' "$locale" > "$target/etc/locale.conf"
 printf '%s\n' "$timezone" > "$target/etc/timezone"
 [ ! -f "/usr/share/zoneinfo/$timezone" ] || cp "/usr/share/zoneinfo/$timezone" "$target/etc/localtime"
 message "Hostname, timezone and locale saved."
}

configure_target() {
    target=$1 hostname=$2 username=$3
    [ -d "$target" ] || die "target directory does not exist: $target"
    [ "$target" != "/" ] || die "refusing to configure the live root filesystem"
    [ ! -L "$target" ] || die "target must not be a symbolic link"
    target=$(cd "$target" && pwd -P)
    [ "$target" != "/" ] || die "invalid target"
    valid_name "$hostname" || die "invalid hostname"
    valid_name "$username" || die "invalid username"
    mkdir -p "$target/etc" "$target/home/$username" "$target/root" "$target/etc/sudoers.d"
    touch "$target/etc/passwd" "$target/etc/group" "$target/etc/shadow" "$target/etc/gshadow"
    grep -q '^root:' "$target/etc/passwd" || printf 'root:x:0:0:root:/root:/bin/sh\n' >> "$target/etc/passwd"
    if ! grep -q "^$username:" "$target/etc/passwd"; then
        uid=$(awk -F: 'BEGIN { max=999 } { if ($3 > max) max=$3 } END { print max+1 }' "$target/etc/passwd")
        gid=$uid
        printf '%s:x:%s:%s:%s User:/home/%s:/bin/sh\n' "$username" "$uid" "$gid" "$username" "$username" >> "$target/etc/passwd"
        printf '%s:x:%s:\n' "$username" "$gid" >> "$target/etc/group"
        printf '%s:!::\n' "$username" >> "$target/etc/gshadow"
    fi
    grep -q '^root:' "$target/etc/group" || printf 'root:x:0:\n' >> "$target/etc/group"
    grep -q '^wheel:' "$target/etc/group" || printf 'wheel:x:10:%s\n' "$username" >> "$target/etc/group"
    if grep -q '^wheel:' "$target/etc/group" && ! awk -F: -v user="$username" '$1 == "wheel" { n=split($4, members, ","); for (i=1; i<=n; i++) if (members[i] == user) found=1 } END { exit !found }' "$target/etc/group"; then
        awk -F: -v user="$username" 'BEGIN { OFS=":" } $1 == "wheel" { if ($4 == "") $4=user; else $4=$4 "," user } { print }' "$target/etc/group" > "$target/etc/group.tmp"
        mv "$target/etc/group.tmp" "$target/etc/group"
    fi
    grep -q '^users:' "$target/etc/group" || printf 'users:x:100:\n' >> "$target/etc/group"
    grep -q '^root:' "$target/etc/shadow" || printf 'root:!:19000:0:99999:7:::\n' >> "$target/etc/shadow"
    grep -q "^$username:" "$target/etc/shadow" || printf '%s:!:19000:0:99999:7:::\n' "$username" >> "$target/etc/shadow"
    grep -q '^root:' "$target/etc/gshadow" || printf 'root:!::\n' >> "$target/etc/gshadow"
    grep -q '^wheel:' "$target/etc/gshadow" || printf 'wheel:!::%s\n' "$username" >> "$target/etc/gshadow"
    grep -q '^users:' "$target/etc/gshadow" || printf 'users:!::\n' >> "$target/etc/gshadow"
    if ! grep -q '^#includedir /etc/sudoers.d' "$target/etc/sudoers" 2>/dev/null; then
        printf '\n# VANTOR additional sudo policies\n#includedir /etc/sudoers.d\n' >> "$target/etc/sudoers"
    fi
    chmod 0644 "$target/etc/sudoers.d/10-wheel" 2>/dev/null || true
    printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$target/etc/sudoers.d/10-wheel"
    chmod 0440 "$target/etc/sudoers.d/10-wheel" 2>/dev/null || true
    chmod 0700 "$target/root" "$target/home/$username" 2>/dev/null || true
    printf '%s\n' "$hostname" > "$target/etc/hostname"
    printf '[VANTOR] %s — ONE SYSTEM. EVERY GENERATION.\n' "$hostname" > "$target/etc/issue"
    printf 'root and %s accounts created with locked passwords. Set passwords before enabling remote access.\n' "$username" > "$target/etc/vantor-accounts"
    info "Configured root and $username accounts, wheel policy, hostname and home directories."
}

install_minimal() {
    target=$(ask "Target" "Mounted target directory (must be empty):" "/mnt") || return 0
    hostname=$(ask "Hostname" "System hostname:" "vantor") || return 0
    username=$(ask "User" "Create standard user:" "live") || return 0
    [ -d "$target" ] || die "target directory does not exist. Mount your target filesystem first."
    [ "$target" != "/" ] || die "refusing to install over the running Live system"
    [ ! -L "$target" ] || die "target must not be a symbolic link"
    target=$(cd "$target" && pwd -P)
    [ "$target" != "/" ] || die "invalid target"
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$target" || die "target is not a mounted filesystem"
    elif ! awk -v path="$target" '$2 == path { found=1 } END { exit !found }' "${VANTOR_PROC_MOUNTS:-/proc/mounts}"; then
        die "target is not a mounted filesystem"
    fi
    if find "$target" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit | grep -q .; then
        die "target is not empty (only lost+found is allowed); choose an empty mounted filesystem"
    fi
    valid_name "$hostname" || die "invalid hostname"
    valid_name "$username" || die "invalid username"
    [ -x "$NYAN_BIN" ] || die "Nyan is not installed in this Live environment"
    message "The installer will install the published Minimal profile into $target. It will not partition or format disks."
    repo=$(ask "Nyan mirror" "HTTPS repository base URL:" "https://vantor-linux.cristopheriguaran-7.workers.dev") || return 0
    case "$repo" in https://*) ;; *) die "mirror must use HTTPS";; esac
    mkdir -p "$target/etc"
    printf '# Nyan repository\nNYAN_REPO=%s\nNYAN_ARCH=%s\n' "$repo" "${NYAN_ARCH:-x86_64}" > "$target/etc/nyan.conf"
    network_setup "$target"
    NYAN_ROOT="$target" NYAN_REPO="$repo" "$NYAN_BIN" update
    NYAN_ROOT="$target" "$NYAN_BIN" install-profile minimal
    configure_target "$target" "$hostname" "$username"
    preferences_setup "$target"
    packages_setup "$target"
    message "VANTOR Minimal has been installed. Passwords are locked; set secure passwords before normal use. Bootloader and filesystem configuration are separate steps in this early installer."
}

prepare_boot_files() {
    target=$1 kernel=$2 initramfs=$3 arch=$4
    [ -d "$target" ] || die "target directory does not exist"
    [ ! -L "$target" ] || die "target must not be a symbolic link"
    target=$(cd "$target" && pwd -P)
    [ "$target" != "/" ] || die "refusing to prepare boot files in the Live root"
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$target" || die "target is not a mounted filesystem"
    elif ! awk -v path="$target" '$2 == path { found=1 } END { exit !found }' /proc/mounts; then
        die "target is not a mounted filesystem"
    fi
    [ -f "$kernel" ] && [ -s "$kernel" ] || die "kernel file is missing or empty"
    [ -f "$initramfs" ] && [ -s "$initramfs" ] || die "initramfs file is missing or empty"
    mounts_file="${VANTOR_PROC_MOUNTS:-/proc/mounts}"
    mount_record=$(awk -v path="$target" '$2 == path { print $1 " " $3; exit }' "$mounts_file")
    [ -n "$mount_record" ] || die "could not determine target filesystem from $mounts_file"
    root_device=$(printf '%s\n' "$mount_record" | awk '{print $1}')
    root_fstype=$(printf '%s\n' "$mount_record" | awk '{print $2}')
    case "$root_device" in /dev/*) ;; *) die "target mount source is not a /dev block device: $root_device";; esac
    case "$root_fstype" in ext2|ext3|ext4) ;; *) die "unsupported root filesystem type: $root_fstype";; esac
    case "$arch" in x86_64|i486) ;; *) die "unsupported boot architecture: $arch";; esac
    mkdir -p "$target/boot" "$target/boot/grub" "$target/etc"
    cp "$kernel" "$target/boot/vantor-kernel"
    cp "$initramfs" "$target/boot/vantor-initramfs.cpio.gz"
    cat > "$target/boot/grub/grub.cfg.tmp" <<EOF
# VANTOR Linux Minimal — installed system
set default=0
set timeout=5
set timeout_style=menu
set menu_color_normal="white/black"
set menu_color_highlight="black/light-cyan"
terminal_output console

menuentry "VANTOR Linux Minimal — $arch" --class vantor {
    search --no-floppy --file --set=root /boot/vantor-kernel
    linux /boot/vantor-kernel root=$root_device rootfstype=$root_fstype rw rootwait console=tty0 loglevel=4
    initrd /boot/vantor-initramfs.cpio.gz
}

menuentry "VANTOR Linux Minimal — Diagnostic mode" --class recovery {
    search --no-floppy --file --set=root /boot/vantor-kernel
    linux /boot/vantor-kernel root=$root_device rootfstype=$root_fstype rw rootwait console=tty0 loglevel=7 initcall_debug
    initrd /boot/vantor-initramfs.cpio.gz
}

menuentry "Reboot" --class reboot { reboot }
menuentry "Power off" --class shutdown { halt }
EOF
    mv "$target/boot/grub/grub.cfg.tmp" "$target/boot/grub/grub.cfg"
    # Keep an existing fstab's non-root entries; replace only our VANTOR root line.
    if [ -f "$target/etc/fstab" ]; then
        grep -v '^# VANTOR installer root' "$target/etc/fstab" | grep -v '^[^#].* / .*' > "$target/etc/fstab.tmp" || true
    else
        : > "$target/etc/fstab.tmp"
    fi
    {
        echo "# VANTOR installer root"
        printf '%s / %s defaults 0 1\n' "$root_device" "$root_fstype"
        echo "proc /proc proc defaults 0 0"
        echo "sysfs /sys sysfs defaults 0 0"
        echo "devtmpfs /dev devtmpfs mode=0755 0 0"
        echo "tmpfs /run tmpfs mode=0755,nosuid 0 0"
        echo "tmpfs /tmp tmpfs mode=1777,nosuid 0 0"
    } >> "$target/etc/fstab.tmp"
    mv "$target/etc/fstab.tmp" "$target/etc/fstab"
    info "Kernel, initramfs, GRUB menu and fstab prepared for $root_device."
    info "GRUB itself is not installed; bootloader installation remains a separate explicit step."
}

prepare_boot_interactive() {
    target=$(ask "Boot files" "Mounted installed system directory:" "/mnt") || return 0
    arch=$(ask "Architecture" "Installed system architecture (x86_64 or i486):" "${NYAN_ARCH:-x86_64}") || return 0
    case "$arch" in
        i486)
            kernel_default="/run/vantor-media/boot/vantor-legacy-kernel"
            initramfs_default="/run/vantor-media/boot/vantor-legacy-initramfs.cpio.gz"
            ;;
        x86_64)
            kernel_default="/run/vantor-media/boot/vantor-kernel"
            initramfs_default="/run/vantor-media/boot/vantor-initramfs.cpio.gz"
            ;;
        *) die "unsupported architecture: $arch";;
    esac
    kernel=$(ask "Kernel" "Path to the VANTOR kernel file:" "$kernel_default") || return 0
    initramfs=$(ask "Initramfs" "Path to the VANTOR initramfs archive:" "$initramfs_default") || return 0
    prepare_boot_files "$target" "$kernel" "$initramfs" "$arch"
    message "Boot files, GRUB menu and fstab prepared. GRUB still needs to be installed to the selected disk using a dedicated bootloader step."
}

storage_inspect() {
    info "Storage inspection is read-only; no partitions or filesystems will be changed."
    if command -v lsblk >/dev/null 2>&1; then
        lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINT 2>/dev/null || lsblk
    elif [ -r /proc/partitions ]; then
        printf '\nBlock devices from /proc/partitions:\n'
        cat /proc/partitions
        if command -v blkid >/dev/null 2>&1; then
            printf '\nDetected filesystem signatures:\n'
            blkid 2>/dev/null || true
        fi
    else
        message "No block-device inventory is available in this Live image."
        return 0
    fi
    message "Disk inspection complete. This screen did not modify storage. Mount an existing Linux filesystem before installing."
}

mount_existing_partition() {
    device=$(ask "Mount existing partition" "Linux partition device (example: /dev/vda2):" "") || return 0
    case "$device" in /dev/*) ;; *) die "device must be under /dev";; esac
    [ -b "$device" ] || die "selected device is not a block device"
    fs=$(ask "Filesystem" "Filesystem type (ext4, ext3 or ext2):" "ext4") || return 0
    case "$fs" in ext2|ext3|ext4) ;; *) die "only ext2, ext3 and ext4 are supported";; esac
    target=$(ask "Mount point" "Where should the partition be mounted?" "/mnt/vantor-target") || return 0
    case "$target" in /*) ;; *) die "mount point must be an absolute path";; esac
    [ "$target" != "/" ] || die "refusing to mount over the Live root"
    mkdir -p "$target"
    [ ! -L "$target" ] || die "mount point must not be a symbolic link"
    if command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$target"; then
        die "mount point is already in use"
    fi
    if awk -v path="$target" '$2 == path { found=1 } END { exit !found }' "${VANTOR_PROC_MOUNTS:-/proc/mounts}"; then
        die "mount point is already mounted"
    fi
    message "VANTOR will mount $device as $fs at $target. No partitioning or formatting will occur."
    mount -t "$fs" -o rw "$device" "$target" || die "mount failed; check filesystem and kernel support"
    info "Mounted $device at $target. Select Install VANTOR Minimal and use this exact mount point."
}

install_bootloader() {
    target=$(ask "GRUB bootloader" "Mounted installed system directory:" "/mnt") || return 0
    [ -d "$target" ] && [ ! -L "$target" ] || die "invalid target directory"
    target=$(cd "$target" && pwd -P)
    [ "$target" != "/" ] || die "refusing to modify the Live root"
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$target" || die "target is not a mounted filesystem"
    else
        awk -v path="$target" '$2 == path { found=1 } END { exit !found }' "${VANTOR_PROC_MOUNTS:-/proc/mounts}" || die "target is not a mounted filesystem"
    fi
    [ -s "$target/boot/grub/grub.cfg" ] || die "GRUB configuration is missing; prepare boot files first"
    if ! command -v grub-install >/dev/null 2>&1; then
        message "grub-install is not included in this Live image yet. No disk was changed. A future image must bundle GRUB BIOS tools before this action can run."
        return 0
    fi
    record=$(awk -v path="$target" '$2 == path { print $1; exit }' "${VANTOR_PROC_MOUNTS:-/proc/mounts}")
    case "$record" in /dev/*) ;; *) die "could not identify the target block device";; esac
    part_name=${record##*/}
    sys_entry="/sys/class/block/$part_name"
    [ -e "$sys_entry" ] || die "target device is not represented in /sys/class/block"
    resolved=$(readlink -f "$sys_entry" 2>/dev/null || echo "$sys_entry")
    parent=$(basename "$(dirname "$resolved")")
    [ -n "$parent" ] && [ "$parent" != block ] || die "could not determine the whole-disk device"
    disk="/dev/$parent"
    [ -b "$disk" ] || die "whole-disk device does not exist: $disk"
    [ ! -e "/sys/class/block/$parent/partition" ] || die "refusing to install GRUB to a partition; whole disk required"
    message "GRUB will write BIOS boot code to $disk and install files under $target/boot. It will not format or partition the disk."
    confirmation=$(ask "Confirm bootloader installation" "Type the exact disk path to continue:" "") || return 0
    [ "$confirmation" = "$disk" ] || die "confirmation did not match; no disk was changed"
    grub-install --target=i386-pc --boot-directory="$target/boot" --recheck "$disk" || die "GRUB installation failed"
    message "GRUB BIOS bootloader installed to $disk. Test the virtual disk in Limbo before relying on it."
}

about() {
    message "VANTOR Linux Minimal Installer $VERSION\n\nA modular text interface. Disk inspection is read-only; existing ext2/ext3/ext4 partitions can be mounted without formatting. It never partitions or formats disks. GRUB installation is available only when grub-install and its BIOS modules are present. The target filesystem must already be mounted."
}

if [ "${1:-}" = "--version" ]; then echo "VANTOR Installer $VERSION"; exit 0; fi
if [ "${1:-}" = "--prepare-boot" ]; then
    [ "$#" -eq 5 ] || die "usage: vantor-install --prepare-boot TARGET KERNEL INITRAMFS ARCH"
    prepare_boot_files "$2" "$3" "$4" "$5"
    exit 0
fi
if [ "${1:-}" = "--configure" ]; then
    [ "$#" -eq 4 ] || die "usage: vantor-install --configure TARGET HOSTNAME USERNAME"
    configure_target "$2" "$3" "$4"
    exit 0
fi
if [ "$(id -u)" -ne 0 ]; then die "run the installer as root"; fi
while :; do
    action=$(menu) || exit 0
    case "$action" in
        install) install_minimal ;;
        configure)
            target=$(ask "Target" "Installed system directory:" "/mnt") || continue
            hostname=$(ask "Hostname" "System hostname:" "vantor") || continue
            username=$(ask "User" "Standard user:" "live") || continue
            configure_target "$target" "$hostname" "$username"
            message "System account configuration completed."
            ;;
        boot) prepare_boot_interactive ;;
        network) network_setup ;;
        mirror) mirror_setup ;;
        packages) packages_setup ;;
        prefs) preferences_setup ;;
        storage) storage_inspect ;;
        bootloader) install_bootloader ;;
        about) about ;;
        exit) clear 2>/dev/null || true; exit 0 ;;
        *) exit 0 ;;
    esac
done
