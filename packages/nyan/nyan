#!/bin/sh
# Nyan — VANTOR native package manager
set -eu

NYAN_ROOT=${NYAN_ROOT:-/}
NYAN_CONFIG="${NYAN_ROOT%/}/etc/nyan.conf"
# Load the selected root's architecture before applying the host defaults.
[ ! -r "$NYAN_CONFIG" ] || . "$NYAN_CONFIG"
NYAN_REPO=${NYAN_REPO:-https://vantor-linux.cristopheriguaran-7.workers.dev}
NYAN_ARCH=${NYAN_ARCH:-x86_64}
NYAN_STATE="${NYAN_ROOT%/}/var/lib/nyan"
NYAN_CACHE="${NYAN_ROOT%/}/var/cache/nyan"
NYAN_CATALOG="${NYAN_ROOT%/}/usr/share/nyan/catalog.tsv"
INDEX_URL="$NYAN_REPO/repo/$NYAN_ARCH/Packages"
INSTALL_STACK=""

die() { echo "nyan: error: $*" >&2; exit 1; }
nyan_cat() {
  label=$1 phase=$2
  [ -t 1 ] || return 0
  case "$phase" in
    0) catface='[=^.^=]'; trail='';;
    1) catface='[=^o^=]'; trail='~~~~';;
    2) catface='[=^.^=]'; trail='~~~~~~~';;
    3) catface='[=^w^=]'; trail='~~~~~~~~~~';;
    *) catface='[=^.^=]'; trail='~~~~~~~~~~~~';;
  esac
  printf '\r\033[1;36m%s\033[0m \033[1;35m%s\033[0m  %s\033[K' "$trail" "$catface" "$label"
  [ "$phase" -eq 4 ] && printf '\n'
}
say() { printf 'nyan: %s\n' "$*"; }
valid_name() { case "$1" in ''|*[!A-Za-z0-9+_.-]*) return 1;; esac; }
fetch() {
  url=$1 output=$2
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 2 -o "$output" "$url"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$output" "$url"
  else die "curl or wget is required"
  fi
}
safe_archive() {
  archive=$1
  tar -tzf "$archive" >/dev/null 2>&1 || die "invalid package archive"
  list="$NYAN_CACHE/archive-list-$$"
  tar -tzf "$archive" > "$list" || die "invalid package archive"
  while IFS= read -r item; do
    case "$item" in /*|../*|*/../*|*/..|..|./../*|*/./../*) rm -f "$list"; die "unsafe archive path: $item";; esac
  done < "$list"
  rm -f "$list"
  tar -tvzf "$archive" > "$NYAN_CACHE/archive-types-$$" || die "cannot inspect package entries"
  while IFS= read -r entry; do
    kind=$(printf '%s' "$entry" | cut -c1)
    case "$kind" in -|d) ;; *) rm -f "$NYAN_CACHE/archive-types-$$"; die "unsupported archive entry type: $kind";; esac
  done < "$NYAN_CACHE/archive-types-$$"
  rm -f "$NYAN_CACHE/archive-types-$$"
}
usage() {
  cat <<'EOF'
Nyan — VANTOR package manager
Usage:
  nyan update
  nyan list
  nyan search TERM
  nyan show PACKAGE
  nyan languages
  nyan install PACKAGE [PACKAGE ...]
  nyan browse
  nyan install-profile PROFILE
  nyan profiles
  nyan installed
  nyan verify [PACKAGE]
  nyan remove PACKAGE
Environment: NYAN_ROOT, NYAN_REPO, NYAN_ARCH
EOF
}
index_file() { printf '%s/Packages' "$NYAN_STATE"; }
package_row() {
  awk -F '\t' -v n="$1" '$1==n {print; exit}' "$(index_file)"
}
install_one() {
  local name record row oldifs pkg version arch digest archive description dependencies dependency file actual temp owned_file item target
  name=$1
  valid_name "$name" || die "invalid package name: $name"
  nyan_cat "Resolving $name" 0
  record="$NYAN_STATE/installed/$name"
  [ ! -s "$record" ] || return 0
  case " $INSTALL_STACK " in *" $name "*) die "dependency cycle detected at $name";; esac
  row=$(package_row "$name")
  [ -n "$row" ] || die "package not found: $name"
  pkg=$(printf '%s\n' "$row" | cut -f1)
  version=$(printf '%s\n' "$row" | cut -f2)
  arch=$(printf '%s\n' "$row" | cut -f3)
  digest=$(printf '%s\n' "$row" | cut -f4)
  archive=$(printf '%s\n' "$row" | cut -f5)
  description=$(printf '%s\n' "$row" | cut -f6)
  dependencies=$(printf '%s\n' "$row" | cut -f7)
  [ "$arch" = "$NYAN_ARCH" ] || [ "$arch" = all ] || die "package architecture mismatch: $name"
  INSTALL_STACK="$INSTALL_STACK $name"
  oldifs=$IFS; IFS=',' 
  for dependency in $dependencies; do
    [ -n "$dependency" ] || continue
    install_one "$dependency"
  done
  IFS=$oldifs
  INSTALL_STACK=${INSTALL_STACK% $name}
  # Recursive shell functions share ordinary variables; reload this package's row
  # after dependency traversal so child metadata cannot overwrite the parent.
  row=$(package_row "$name")
  pkg=$(printf '%s\n' "$row" | cut -f1)
  version=$(printf '%s\n' "$row" | cut -f2)
  arch=$(printf '%s\n' "$row" | cut -f3)
  digest=$(printf '%s\n' "$row" | cut -f4)
  archive=$(printf '%s\n' "$row" | cut -f5)
  description=$(printf '%s\n' "$row" | cut -f6)
  dependencies=$(printf '%s\n' "$row" | cut -f7)
  case "$digest" in *[!0-9a-f]*|'') die "invalid SHA-256 for $name";; esac
  [ "${#digest}" -eq 64 ] || die "invalid SHA-256 length for $name"
  case "$archive" in *[!A-Za-z0-9._+-]*|*..*) die "invalid archive filename";; esac
  mkdir -p "$NYAN_CACHE" "$NYAN_STATE/installed"
  file="$NYAN_CACHE/$archive"
  nyan_cat "Downloading $name" 1
  fetch "$NYAN_REPO/packages/$NYAN_ARCH/$archive" "$file"
  nyan_cat "Verifying $name" 2
  actual=$(sha256sum "$file" | awk '{print $1}')
  [ "$actual" = "$digest" ] || die "SHA-256 verification failed for $name"
  safe_archive "$file"
  temp="$NYAN_CACHE/unpack-$name-$$"
  rm -rf "$temp"; mkdir -p "$temp"
  nyan_cat "Unpacking $name" 3
  tar -xzf "$file" -C "$temp"
  (cd "$temp" && find . -type f -o -type l) | sed 's#^./##' > "$NYAN_STATE/installed/$name.files"
  for owned_file in "$NYAN_STATE"/installed/*.files; do
    [ -f "$owned_file" ] || continue
    [ "$owned_file" = "$NYAN_STATE/installed/$name.files" ] && continue
    while IFS= read -r item; do
      grep -F -x -q "$item" "$owned_file" && die "file conflict: $item is already owned by another package"
    done < "$NYAN_STATE/installed/$name.files"
  done
  while IFS= read -r item; do
    target="${NYAN_ROOT%/}/$item"
    [ ! -e "$target" ] && [ ! -L "$target" ] || die "refusing to overwrite existing system path: $item"
  done < "$NYAN_STATE/installed/$name.files"
  tar -xzf "$file" -C "${NYAN_ROOT%/}"
  printf '%s\t%s\t%s\n' "$name" "$version" "$digest" > "$record"
  rm -rf "$temp"
  nyan_cat "Installed $name $version" 4
  say "installed $name $version"
}
[ "$#" -ge 1 ] || { usage; exit 2; }
cmd=$1
case "$cmd" in
  update)
    mkdir -p "$NYAN_STATE"
    tmp="$NYAN_STATE/Packages.tmp"
    fetch "$INDEX_URL" "$tmp"
    grep -q '^# VANTOR-PACKAGES 1$' "$tmp" || die "repository index format is unsupported"
    mv "$tmp" "$(index_file)"
    say "repository index updated ($NYAN_ARCH)"
    ;;
  list)
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    awk -F '\t' '!/^#/ && NF >= 6 { printf "%-22s %-12s %s\n", $1, $2, $6 }' "$index"
    ;;
  search)
    [ "$#" -eq 2 ] || die "usage: nyan search TERM"
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    awk -F '\t' -v q="$2" 'BEGIN{IGNORECASE=1} !/^#/ && ($1 ~ q || $6 ~ q) {printf "%-22s %-12s %s\n",$1,$2,$6}' "$index"
    ;;
  show)
    [ "$#" -eq 2 ] || die "usage: nyan show PACKAGE"
    row=$(package_row "$2"); [ -n "$row" ] || die "package not found: $2"
    printf '%s\n' "$row" | awk -F '\t' '{printf "Name: %s\nVersion: %s\nArchitecture: %s\nDescription: %s\nDependencies: %s\n",$1,$2,$3,$6,($7==""?"none":$7)}'
    ;;
  catalog)
    [ -r "$NYAN_CATALOG" ] || die "package catalog is not installed"
    printf "%-24s %-15s %-10s %s\n" "PACKAGE" "CATEGORY" "STATUS" "DESCRIPTION"
    awk -F '\t' '!/^#/ && NF >= 4 {printf "%-24s %-15s %-10s %s\n",$1,$2,$3,$4}' "$NYAN_CATALOG"
    ;;
  languages)
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    echo "Programming languages available:"
    awk -F '\t' '!/^#/ && NF >= 6 && $6 ~ /^Language:/ {printf "  %-18s %-10s %s\n",$1,$2,substr($6,10)}' "$index"
    ;;
  profiles)
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    echo "VANTOR installation profiles:"
    for profile in minimal base desktop development network; do
      case "$profile" in
        minimal) description="VANTOR Minimal base system";;
        base) description="Essential command-line system";;
        desktop) description="Graphical desktop environment";;
        development) description="Compilers and programming languages";;
        network) description="Network utilities and diagnostics";;
      esac
      if package_row "vantor-profile-$profile" >/dev/null 2>&1 && [ -n "$(package_row "vantor-profile-$profile")" ]; then
        printf "  %-13s available — %s\\n" "$profile" "$description"
      else
        printf "  %-13s planned   — %s\\n" "$profile" "$description"
      fi
    done
    ;;
  install-profile)
    [ "$#" -eq 2 ] || die "usage: nyan install-profile PROFILE"
    case "$2" in minimal|base|desktop|development|network) ;; *) die "unknown profile: $2";; esac
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    package="vantor-profile-$2"
    [ -n "$(package_row "$package")" ] || die "profile '$2' is not published yet"
    mkdir -p "$NYAN_STATE/installed" "$NYAN_CACHE"
    install_one "$package"
    say "profile '$2' installed"
    ;;
  browse)
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    printf "Available Nyan packages for %s:\n" "$NYAN_ARCH"
    awk -F '\t' '!/^#/ && NF >= 6 {printf "  %-24s %-12s %s\n",$1,$2,$6}' "$index"
    ;;
  install)
    [ "$#" -ge 2 ] || die "usage: nyan install PACKAGE [PACKAGE ...]"
    index=$(index_file); [ -s "$index" ] || die "run 'nyan update' first"
    mkdir -p "$NYAN_STATE/installed" "$NYAN_CACHE"
    shift
    for package do install_one "$package"; done
    say "requested package set processed"
    ;;
  installed)
    [ "$#" -eq 1 ] || die "usage: nyan installed"
    dir="$NYAN_STATE/installed"
    printf "%-24s %-12s %s\n" "PACKAGE" "VERSION" "STATUS"
    found=0
    for record in "$dir"/*; do
      [ -f "$record" ] || continue
      case "$record" in *.files) continue;; esac
      name=${record##*/}
      valid_name "$name" || continue
      version=$(cut -f2 "$record")
      printf "%-24s %-12s installed\n" "$name" "${version:-unknown}"
      found=1
    done
    [ "$found" -eq 1 ] || say "no packages installed"
    ;;
  verify)
    [ "$#" -le 2 ] || die "usage: nyan verify [PACKAGE]"
    dir="$NYAN_STATE/installed"
    [ -d "$dir" ] || die "no installed package database"
    failed=0
    if [ "$#" -eq 2 ]; then
      valid_name "$2" || die "invalid package name: $2"
      set -- "$2"
    else
      set -- 
      for record in "$dir"/*; do
        [ -f "$record" ] || continue
        case "$record" in *.files) continue;; esac
        set -- "$@" "${record##*/}"
      done
    fi
    for name do
      record="$dir/$name"
      files="$dir/$name.files"
      if [ ! -s "$record" ] || [ ! -s "$files" ]; then
        printf "nyan: verify: incomplete record for %s\n" "$name" >&2
        failed=1
        continue
      fi
      missing=0
      while IFS= read -r item; do
        [ -n "$item" ] || continue
        case "$item" in /*|../*|*/../*|*/..) printf "nyan: verify: unsafe file record: %s\n" "$item" >&2; missing=1; continue;; esac
        target="${NYAN_ROOT%/}/$item"
        [ -e "$target" ] || [ -L "$target" ] || { printf "nyan: verify: missing %s\n" "$item" >&2; missing=1; }
      done < "$files"
      if [ "$missing" -eq 0 ]; then say "verified $name"; else failed=1; fi
    done
    [ "$failed" -eq 0 ] || die "verification failed"
    ;;
  remove)
    [ "$#" -eq 2 ] || die "usage: nyan remove PACKAGE"
    name=$2; valid_name "$name" || die "invalid package name"
    record="$NYAN_STATE/installed/$name"; files="$NYAN_STATE/installed/$name.files"
    [ -s "$record" ] && [ -s "$files" ] || die "package is not recorded as installed"
    while IFS= read -r item; do
      case "$item" in /*|../*|*/../*|*/..) die "unsafe installed-file record";; esac
      rm -f "${NYAN_ROOT%/}/$item"
    done < "$files"
    rm -f "$record" "$files"
    say "removed $name (dependency cleanup is manual)"
    ;;
  -h|--help|help) usage ;;
  *) usage; die "unknown command: $cmd" ;;
esac
