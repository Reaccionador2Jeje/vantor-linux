#!/bin/sh
set -eu

os="VANTOR Linux"
if [ -r /etc/os-release ]; then
    . /etc/os-release
    [ -n "${PRETTY_NAME:-}" ] && os=$PRETTY_NAME
fi
host=$(hostname 2>/dev/null || echo unknown)
kernel=$(uname -sr 2>/dev/null || echo unknown)
arch=$(uname -m 2>/dev/null || echo unknown)
uptime=unknown
if [ -r /proc/uptime ]; then
    uptime=$(awk '{printf "%dh %dm",int($1/3600),int(($1%3600)/60)}' /proc/uptime)
fi
mem=unknown
if [ -r /proc/meminfo ]; then
    mem=$(awk '/MemTotal:/ {printf "%.0f MiB",$2/1024}' /proc/meminfo)
fi
cpu=unknown
if [ -r /proc/cpuinfo ]; then
    cpu=$(awk -F: '/model name|Hardware/ {gsub(/^[ \t]+/,"",$2); print $2; exit}' /proc/cpuinfo)
    [ -n "$cpu" ] || cpu=unknown
fi
shell=${SHELL:-/bin/sh}
init=unknown
[ ! -r /proc/1/comm ] || IFS= read -r init < /proc/1/comm

cyan=''
blue=''
metal=''
muted=''
reset=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    cyan='\033[1;36m'
    blue='\033[1;34m'
    metal='\033[1;37m'
    muted='\033[0;90m'
    reset='\033[0m'
fi

# Large VANTOR orbital V emblem with a compact system summary.
printf "  %b       .-=======================-.%b    %bVANTOR LINUX%b\n" "$cyan" "$reset" "$metal" "$reset"
printf "  %b     .                           .%b    %b%s%b\n" "$cyan" "$reset" "$metal" "$os" "$reset"
printf "  %b    /        %b\\\\             /%b        \\\\%b   %b%s%b\n" "$cyan" "$metal" "$cyan" "$reset" "$blue" "ONE SYSTEM. EVERY GENERATION." "$reset"
printf "  %b   |          %b\\\\           /%b          |%b   Host:         %s\n" "$cyan" "$metal" "$cyan" "$reset" "$host"
printf "  %b   |           %b\\\\         /%b           |%b   Kernel:       %s\n" "$cyan" "$metal" "$cyan" "$reset" "$kernel"
printf "  %b   |            %b\\\\       /%b            |%b   Architecture: %s\n" "$cyan" "$metal" "$cyan" "$reset" "$arch"
printf "  %b   |             %b\\\\     /%b             |%b   CPU:          %s\n" "$cyan" "$metal" "$cyan" "$reset" "$cpu"
printf "  %b   |              %b\\\\   /%b              |%b   Memory:       %s\n" "$cyan" "$metal" "$cyan" "$reset" "$mem"
printf "  %b   |               %b\\\\ /%b               |%b   Uptime:       %s\n" "$cyan" "$metal" "$cyan" "$reset" "$uptime"
printf "  %b   |                %bV%b                |%b   Shell:        %s\n" "$cyan" "$metal" "$cyan" "$reset" "$shell"
printf "  %b    \\\\                             /%b    Init:         %s\n" "$cyan" "$reset" "$init"
printf "  %b     .                         .%b    Nyan:         native\n" "$cyan" "$reset"
printf "  %b       -_____________________- %b    Profile:      VANTOR\n" "$cyan" "$reset"
printf '\n'
