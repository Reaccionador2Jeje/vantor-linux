#!/bin/sh
set -eu
out=${1:-"vantor-config-$(date +%Y%m%d-%H%M%S).tar.gz"}
case "$out" in /*) ;; *) out="$PWD/$out";; esac
[ ! -e "$out" ] || { echo "Refusing to overwrite: $out" >&2; exit 1; }
tmp="$out.tmp.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM
set -- 
for path in etc/hostname etc/hosts etc/nyan.conf etc/fstab etc/vantor etc/network; do
  [ ! -e "/$path" ] || set -- "$@" "$path"
done
[ "$#" -gt 0 ] || { echo "No VANTOR configuration files found." >&2; exit 1; }
tar -czf "$tmp" -C / "$@"
mv "$tmp" "$out"
trap - EXIT HUP INT TERM
echo "Configuration backup created: $out"
