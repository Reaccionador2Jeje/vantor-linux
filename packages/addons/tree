#!/bin/sh
set -eu
usage() { echo "Usage: tree [directory]"; }
[ "$#" -le 1 ] || { usage >&2; exit 2; }
root=${1:-.}
[ -d "$root" ] || { echo "tree: not a directory: $root" >&2; exit 1; }
printf '%s\n' "$root"
walk() {
  dir=$1 prefix=$2
  set -- "$dir"/*
  [ -e "$1" ] || return 0
  for path do
    [ -e "$path" ] || [ -L "$path" ] || continue
    base=${path##*/}
    if [ -d "$path" ] && [ ! -L "$path" ]; then
      printf '%s+-- %s/\n' "$prefix" "$base"
      walk "$path" "$prefix|   "
    else
      printf '%s+-- %s\n' "$prefix" "$base"
    fi
  done
}
walk "$root" ""
