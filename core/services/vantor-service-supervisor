#!/bin/sh
# VANTOR foreground service supervisor.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/local/bin
name=${1:-}
script=${2:-}
policy=${3:-never}
delay=${4:-3}
logfile=${5:-/var/log/vantor-services/service.log}
case "$name" in ''|*[!A-Za-z0-9_-]*) exit 2;; esac
[ -x "$script" ] || exit 1
case "$policy" in never|on-failure|always) ;; *) exit 2;; esac
case "$delay" in ''|*[!0-9]*) exit 2;; esac
[ "$delay" -ge 1 ] && [ "$delay" -le 60 ] || exit 2
mkdir -p "${logfile%/*}"
stopping=0
child=
stop_child() {
    stopping=1
    if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null || true; fi
}
trap stop_child TERM INT
attempts=0
while :; do
    printf '[%s] starting (policy=%s)\n' "$name" "$policy" >> "$logfile"
    "$script" >> "$logfile" 2>&1 &
    child=$!
    wait "$child"
    result=$?
    child=
    [ "$stopping" -eq 1 ] && exit 0
    case "$policy" in
        never) exit "$result";;
        on-failure) [ "$result" -ne 0 ] || exit 0;;
        always) :;;
    esac
    attempts=$((attempts + 1))
    printf '[%s] exited with status %s; restart attempt %s/5\n' "$name" "$result" "$attempts" >> "$logfile"
    if [ "$attempts" -ge 5 ]; then
        printf '[%s] restart limit reached; leaving service stopped\n' "$name" >> "$logfile"
        exit 1
    fi
    sleep "$delay"
done
