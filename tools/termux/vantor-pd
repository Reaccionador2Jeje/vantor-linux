#!/data/data/com.termux/files/usr/bin/sh
# Convenient login wrapper for the VANTOR PRoot-Distro container.
set -eu
if ! command -v proot-distro >/dev/null 2>&1; then
  echo "Install PRoot-Distro: pkg install proot-distro" >&2
  exit 1
fi
if [ "$#" -eq 0 ]; then
  exec proot-distro login vantor -- /usr/bin/vantor-termux-shell
fi
exec proot-distro login vantor -- "$@"
