#!/data/data/com.termux/files/usr/bin/sh
# Install the official VANTOR ARM64 rootfs into Termux PRoot-Distro.
set -eu

VERSION="0.1.0"
RELEASE="https://github.com/Reaccionador2Jeje/vantor-linux/releases/download/termux-aarch64"
ARCHIVE="vantor-termux-aarch64-$VERSION.tar.gz"
WORK="${TMPDIR:-$PREFIX/tmp}/vantor-install-$$"
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT HUP INT TERM

if [ "$(uname -m)" != aarch64 ]; then
  echo "VANTOR requires an ARM64 Termux host (aarch64)." >&2
  exit 1
fi
if ! command -v proot-distro >/dev/null 2>&1; then
  echo "Install PRoot-Distro first: pkg install proot-distro" >&2
  exit 1
fi
if ! command -v curl >/dev/null 2>&1 || ! command -v sha256sum >/dev/null 2>&1; then
  echo "Install curl and coreutils first: pkg install curl coreutils" >&2
  exit 1
fi
if proot-distro list 2>/dev/null | grep -Eiq '(^|[[:space:]])vantor([[:space:]]|$)'; then
  echo "A PRoot-Distro installation named 'vantor' already exists." >&2
  echo "Use 'proot-distro login vantor' or remove it explicitly before reinstalling." >&2
  exit 1
fi

mkdir -p "$WORK"
curl -fL --retry 3 "$RELEASE/$ARCHIVE" -o "$WORK/$ARCHIVE"
curl -fL --retry 3 "$RELEASE/SHA256SUMS" -o "$WORK/SHA256SUMS"
(
  cd "$WORK"
  grep -E "^[0-9a-f]{64}[[:space:]]+$ARCHIVE$" SHA256SUMS | sha256sum -c -
)

echo "Installing VANTOR Linux $VERSION into PRoot-Distro..."
proot-distro install "$WORK/$ARCHIVE" --name vantor
echo
echo "VANTOR is installed."
echo "Enter with: proot-distro login vantor -- /usr/bin/vantor-termux-shell"
